# Copy this file to .env and fill in your own values, then load it before
# running the retrieval commands. The .env file is git-ignored and must NEVER
# be committed.
#
#   cp .env.example .env        # then edit .env
#   set -a; source .env; set +a # macOS / Linux
#   # Windows PowerShell: see README "配置凭据"
#
# Every credential is read from the environment. Nothing is hard-coded, and no
# script in this project writes a key to disk.

# --- NCBI / PubMed -----------------------------------------------------------
# Optional. Without it PubMed allows 3 requests/second; with it, 10/second.
# Get one free: NCBI account -> Account Settings -> API Key Management.
NCBI_API_KEY=

# --- API politeness ----------------------------------------------------------
# Optional but recommended. A contact address puts Crossref/OpenAlex requests
# into their faster pools and identifies you to NCBI as a well-behaved client.
CONTACT_EMAIL=

# --- Local options (not secrets) --------------------------------------------
# Browser executable, if auto-detection fails.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Chrome DevTools Protocol port used by the CNKI module.
# CDP_PORT=9222
