# dependencies
node_modules/

# ---------------------------------------------------------------- SECRETS
# Never commit credentials. All API keys are read from the environment.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
secrets/
credentials.json

# Chrome profile created by the launcher (contains an institution session)
.chrome-profile*/

# retrieval output (may contain licensed abstracts - keep local)
# Patterns cover the --out names used in the docs, including suffixed variants
# such as results-all or out-check, which a bare "out/" would miss.
out/
out-*/
out_*/
results/
results-*/
results_*/

# local npm cache (used when the default cache is not writable)
.npm-cache/

# probe leftovers / OS noise
.chrome-stderr.txt
.chrome-stdout.txt
.DS_Store
Thumbs.db

# reference repositories cloned for study (re-clone with the README commands)
repos/
